rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read services and public profile
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true; // In production, add auth or PIN validation
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
